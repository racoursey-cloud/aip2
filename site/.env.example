# Copy to .env.local for local development. .env* is gitignored — never commit a real value.
#
# The service-role key bypasses RLS and is read ONLY in server components and route
# handlers. It has no NEXT_PUBLIC_ prefix precisely so Next.js cannot bundle it for a browser.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
